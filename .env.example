# Which LLM backend to use: openai | anthropic | ollama
LLM_PROVIDER=openai

# --- OpenAI (default provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ollama (local, no key required) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_NUM_CTX=8192

# --- Upload limits ---
MAX_UPLOAD_MB=50

# --- LLM call resilience ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
